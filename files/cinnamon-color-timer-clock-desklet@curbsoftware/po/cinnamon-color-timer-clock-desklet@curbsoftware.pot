#. settings-schema.json->clock-schedule->description
#. settings-schema.json->timer-schedule->description
#. settings-schema.json->chrono-schedule->description
msgid "Color schedule"
msgstr ""

#. settings-schema.json->clock-schedule->tooltip
msgid ""
"Card background color at a given time of day, interpolated between stops and"
" wrapping over midnight. Tick Notify to pop a desktop notification when the "
"clock reaches that time. Colors: hex (#rgb, #rgba, #rrggbb or #rrggbbaa) or "
"a name: black, white, red, orange, yellow, lime, green, teal, cyan, blue, "
"purple, magenta, grey."
msgstr ""

#. settings-schema.json->clock-schedule->columns->title
msgid "Hour"
msgstr ""

#. settings-schema.json->clock-schedule->columns->title
msgid "Minute"
msgstr ""

#. settings-schema.json->clock-schedule->columns->title
#. settings-schema.json->timer-schedule->columns->title
#. settings-schema.json->chrono-schedule->columns->title
msgid "Color"
msgstr ""

#. settings-schema.json->clock-schedule->columns->title
#. settings-schema.json->chrono-schedule->columns->title
msgid "Notify"
msgstr ""

#. settings-schema.json->clock-smooth->description
#. settings-schema.json->timer-smooth->description
#. settings-schema.json->chrono-smooth->description
msgid "Smooth color transitions"
msgstr ""

#. settings-schema.json->clock-smooth->tooltip
#. settings-schema.json->timer-smooth->tooltip
#. settings-schema.json->chrono-smooth->tooltip
msgid ""
"Blend gradually between schedule stops. When disabled, each color holds "
"until the next stop and then jumps."
msgstr ""

#. settings-schema.json->timer->description
msgid "Timer card"
msgstr ""

#. settings-schema.json->timer-minutes->units
msgid "min"
msgstr ""

#. settings-schema.json->timer-minutes->description
msgid "Timer minutes"
msgstr ""

#. settings-schema.json->timer-minutes->tooltip
msgid ""
"Default timer duration. Hour, minute and second buttons on the card change "
"it while the timer is stopped."
msgstr ""

#. settings-schema.json->timer-seconds->units
msgid "s"
msgstr ""

#. settings-schema.json->timer-seconds->description
msgid "Timer seconds"
msgstr ""

#. settings-schema.json->timer-schedule->tooltip
msgid ""
"Card background color at a given remaining time, interpolated between stops "
"and holding the last stop's color beyond it. Colors: hex (#rgb, #rgba, "
"#rrggbb or #rrggbbaa) or a name: black, white, red, orange, yellow, lime, "
"green, teal, cyan, blue, purple, magenta, grey."
msgstr ""

#. settings-schema.json->timer-schedule->columns->title
msgid "Remaining seconds"
msgstr ""

#. settings-schema.json->timer-notify->description
msgid "Show a notification when the timer finishes"
msgstr ""

#. settings-schema.json->timer-notify->tooltip
msgid "Pops a desktop notification when the countdown reaches zero."
msgstr ""

#. settings-schema.json->chrono->description
msgid "Chronometer card"
msgstr ""

#. settings-schema.json->chrono-schedule->tooltip
msgid ""
"Card background color at a given elapsed time, interpolated between stops "
"and holding the last stop's color beyond it. Tick Notify to pop a desktop "
"notification when the chronometer reaches that elapsed time. Colors: hex "
"(#rgb, #rgba, #rrggbb or #rrggbbaa) or a name: black, white, red, orange, "
"yellow, lime, green, teal, cyan, blue, purple, magenta, grey."
msgstr ""

#. settings-schema.json->chrono-schedule->columns->title
msgid "Elapsed seconds"
msgstr ""

#. settings-schema.json->chrono-milliseconds->description
msgid "Show hundredths of a second"
msgstr ""

#. settings-schema.json->chrono-milliseconds->tooltip
msgid ""
"Adds a .ss fraction to the chronometer. The card updates 20 times per second"
" while it runs; paused it freezes the fraction, stopped it reads 00:00.00."
msgstr ""

