#. settings-schema.json->date-size->description
msgid "Maximum date font size"
msgstr ""

#. settings-schema.json->date-size->tooltip
msgid "Cards scale down from this size so the date stays inside the card"
msgstr ""

#. settings-schema.json->label-size->description
msgid "Maximum card title font size"
msgstr ""

#. settings-schema.json->label-size->tooltip
